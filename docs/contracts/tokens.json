{
  "$comment": "CARAMEL_PROJECT design tokens. Authoritative for all design values. Component code references tokens; it never inlines literals. Add a token rather than hardcoding.",
  "color": {
    "$comment": "FILL: semantic roles, not raw hue names. Provide light and dark for each.",
    "surface": { "light": "#FFFFFF", "dark": "#0B0B0C" },
    "onSurface": { "light": "#111113", "dark": "#F2F2F3" },
    "muted": { "light": "#6B6B70", "dark": "#9A9AA0" },
    "primary": { "light": "#000000", "dark": "#FFFFFF" },
    "danger": { "light": "#B3261E", "dark": "#F2B8B5" }
  },
  "space": {
    "$comment": "FILL: one scale, used everywhere. Values in px.",
    "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64
  },
  "radius": { "none": 0, "sm": 4, "md": 8, "lg": 16, "full": 9999 },
  "type": {
    "$comment": "FILL: each step needs a stated role or it will be used arbitrarily.",
    "family": { "sans": "FILL", "mono": "FILL" },
    "scale": {
      "display": { "size": 32, "lineHeight": 38, "weight": 600, "role": "FILL" },
      "title":   { "size": 22, "lineHeight": 28, "weight": 600, "role": "FILL" },
      "body":    { "size": 16, "lineHeight": 24, "weight": 400, "role": "FILL" },
      "caption": { "size": 13, "lineHeight": 18, "weight": 400, "role": "FILL" }
    }
  },
  "motion": {
    "duration": { "fast": 120, "base": 200, "slow": 320 },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)" }
  }
}
